      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- Loads and saves player progress with DataStores.
-- NOTE: DataStores only work once the game is published and
-- "Enable Studio Access to API Services" is turned on in Game Settings > Security.
-- Until then the game still runs — progress just doesn't persist.

local DataStoreService = game:GetService("DataStoreService")

local DataManager = {}

local STORE_NAME = "PlayerData_v1"
local KEY_PREFIX = "player_"
local RETRIES = 3

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[ClickEmpire] DataStores unavailable — progress will NOT save. " ..
			"(Normal in Studio until the game is published with API access enabled.) " .. tostring(result))
	end
end

local DEFAULT_DATA = {
	Cash = 0,
	TotalEarned = 0,
	TotalClicks = 0,
	Rebirths = 0,
	Upgrades = {}, -- map of upgrade id -> amount owned
}

function DataManager.NewDefault()
	local data = table.clone(DEFAULT_DATA)
	data.Upgrades = {}
	return data
end

-- Returns (data, loadedSafely). When loadedSafely is false we refuse to save
-- later, so a temporary outage can never wipe a player's real progress.
function DataManager.Load(player)
	if not store then
		return DataManager.NewDefault(), false
	end

	local key = KEY_PREFIX .. player.UserId
	for attempt = 1, RETRIES do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			if type(result) == "table" then
				-- fill in any fields added to the game since this player last played
				for field, defaultValue in DEFAULT_DATA do
					if result[field] == nil then
						result[field] = if type(defaultValue) == "table" then {} else defaultValue
					end
				end
				return result, true
			end
			return DataManager.NewDefault(), true -- brand new player
		end
		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	warn(("[ClickEmpire] Failed to load data for %s — playing without saving this session"):format(player.Name))
	return DataManager.NewDefault(), false
end

function DataManager.Save(player, data)
	if not store then
		return false
	end

	local key = KEY_PREFIX .. player.UserId
	for attempt = 1, RETRIES do
		local ok = pcall(function()
			store:UpdateAsync(key, function()
				return data
			end)
		end)
		if ok then
			return true
		end
		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	warn(("[ClickEmpire] Failed to save data for %s"):format(player.Name))
	return false
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[-- Global top-10 leaderboard: a physical board near spawn showing the
-- players who have earned the most cash of all time (OrderedDataStore).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local Leaderboard = {}

local orderedStore = nil
pcall(function()
	orderedStore = DataStoreService:GetOrderedDataStore("TotalEarned_v1")
end)

local nameCache = {}
local rowLabels = {}

function Leaderboard.Submit(userId, totalEarned)
	if not orderedStore then
		return
	end
	local amount = math.floor(totalEarned)
	if amount <= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			orderedStore:SetAsync(tostring(userId), amount)
		end)
	end)
end

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local name = "Player " .. userId
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok then
		name = result
	end
	nameCache[userId] = name
	return name
end

local function createBoard()
	local board = Instance.new("Part")
	board.Name = "GlobalLeaderboard"
	board.Anchored = true
	board.Size = Vector3.new(16, 9, 1)
	board.Position = Vector3.new(0, 7.5, -30)
	board.Color = Color3.fromRGB(28, 30, 40)
	board.Material = Enum.Material.SmoothPlastic

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- this side faces the spawn point
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 56)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 36
	title.TextColor3 = Color3.fromRGB(255, 196, 60)
	title.Text = "🏆 TOP EARNERS"
	title.Parent = gui

	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 24, 0, 60)
	list.Size = UDim2.new(1, -48, 1, -70)
	list.Parent = gui

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = list

	for i = 1, Config.LeaderboardSize do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 26)
		row.Font = Enum.Font.GothamBold
		row.TextSize = 20
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Color3.fromRGB(230, 232, 240)
		row.LayoutOrder = i
		row.Text = ""
		row.Parent = list
		rowLabels[i] = row
	end

	board.Parent = workspace
end

function Leaderboard.Start()
	createBoard()

	if not orderedStore then
		rowLabels[1].Text = "Leaderboard needs a published game with API access"
		return
	end

	task.spawn(function()
		while true do
			local ok, pages = pcall(function()
				return orderedStore:GetSortedAsync(false, Config.LeaderboardSize)
			end)
			if ok then
				local page = pages:GetCurrentPage()
				for i = 1, Config.LeaderboardSize do
					local entry = page[i]
					if entry then
						local userId = tonumber(entry.key) or 0
						rowLabels[i].Text = ("%d.  %s  —  $%s"):format(i, getName(userId), Format(entry.value))
					else
						rowLabels[i].Text = ""
					end
				end
			end
			task.wait(Config.LeaderboardRefreshInterval)
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
